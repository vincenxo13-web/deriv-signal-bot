# Deriv public market stream. Signal-only mode does not need DERIV_API_TOKEN.
DERIV_APP_ID=1089
SYMBOLS=BOOM300N,BOOM500,CRASH300N,CRASH500

# Telegram alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_numeric_chat_id_here
TELEGRAM_PARSE_MODE=HTML
NOTIFY_ON_START=true

# Persistent Railway volume
DATA_DIR=/app/data
WARM_START_CANDLE_LIMIT=12000

# Signal behavior
MIN_SIGNAL_SCORE=72
SIGNAL_WARMUP_BARS=220
SIGNAL_TIMEZONE=Asia/Kuala_Lumpur
TICK_SAMPLE_SECONDS=2

# TP/SL model
ENTRY_ZONE_ATR_MULTIPLIER=0.10
STOP_LOSS_ATR_MULTIPLIER=3.0
TAKE_PROFIT_1_ATR_MULTIPLIER=4.5
TAKE_PROFIT_2_ATR_MULTIPLIER=7.5
MIN_RISK_REWARD=1.0

# Outcome tracking
OUTCOME_TRACKING_ENABLED=true
SIGNAL_EXPIRY_MINUTES=180
NOTIFY_SIGNAL_OUTCOMES=false

# Alert throttling
MAX_SIGNALS_PER_SYMBOL_PER_HOUR=1
MIN_MINUTES_BETWEEN_SIGNALS_SAME_SYMBOL=20
COOLDOWN_AFTER_SPIKE_SECONDS=5

# Risk/noise filters
ESTIMATED_SPREAD_POINTS=4
MAX_SPREAD_POINTS_ESTIMATE=15
EXTREME_ATR_RATIO_THRESHOLD=3.2

# Spike detection thresholds
SPIKE_BODY_ATR_MULTIPLIER_BOOM=2.5
SPIKE_BODY_ATR_MULTIPLIER_CRASH=2.5
SPIKE_TICK_VELOCITY_THRESHOLD_BOOM=0.0015
SPIKE_TICK_VELOCITY_THRESHOLD_CRASH=0.0015

# Dashboard/logging
DASHBOARD_REFRESH_SECONDS=2
LOG_LEVEL=INFO

# Trigger-only alerts
PREPARATION_ALERTS_ENABLED=false
TRIGGER_ALERTS_ENABLED=true
TRIGGER_MIN_SIGNAL_SCORE=74
TRIGGER_SPIKE_STRENGTH=0.80
TRIGGER_TICK_VELOCITY_MIN=0.008

# Stricter loss-control confirmation gates
REQUIRE_TREND_ALIGNMENT=false
REQUIRE_REGIME_ALIGNMENT=true
ALLOW_COUNTER_REGIME_REVERSAL=false
STOCH_ENABLED=true
REQUIRE_STOCH_FOR_TRIGGER=false
REQUIRE_MICRO_BREAK_FOR_TRIGGER=false
REQUIRE_WICK_OR_MICRO_FOR_TRIGGER=true
ALLOW_DRIFT_ONLY_CONFIRMATION=false
MIN_TRIGGER_SCORE_WITHOUT_MICRO_BREAK=78
MIN_TRIGGER_SCORE_WITHOUT_WICK=76
MAX_TRIGGER_STOCH_BUY=72
MIN_TRIGGER_STOCH_SELL=28
MICRO_BREAK_LOOKBACK=3

# Score honesty caps
SCORE_CAP_WITHOUT_BPR=92
SCORE_CAP_HIGH_VOLATILITY=86
SCORE_CAP_NO_HARD_CONFIRMATION=78
