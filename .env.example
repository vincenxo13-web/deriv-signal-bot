# Copy to .env and fill in real values. Never commit .env.

# Required for WebSocket connection (Deriv registered application ID — integer).
DERIV_APP_ID=1089

# Optional: API token for account-specific endpoints / future execution mode only.
DERIV_API_TOKEN=your_demo_or_real_token_here

# Notifications (optional — leave blank to use console only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Operating mode: signal_only | paper | live (live still requires flags below)
MODE=signal_only

# Comma-separated symbol short names — verify names in Deriv active symbols list.
SYMBOLS=BOOM1000,BOOM500,BOOM300,CRASH1000,CRASH500,CRASH300

MIN_SIGNAL_SCORE=75
RISK_PERCENT=1.0

# Safety: must be exactly "true" to allow any proposal/buy/sell API calls.
ENABLE_REAL_TRADING=false

# Extra confirmation for real money — must be "I_UNDERSTAND_REAL_TRADING_RISK" when enabling execution.
DERIV_REAL_TRADING_CONFIRM=

# Tick storage: sample interval in seconds (higher = fewer DB writes). 0 = store every tick.
TICK_SAMPLE_SECONDS=2

# Risk manager
MAX_SIGNALS_PER_SYMBOL_PER_HOUR=8
MIN_MINUTES_BETWEEN_SIGNALS_SAME_SYMBOL=15
MAX_SPREAD_POINTS_ESTIMATE=15
ESTIMATED_SPREAD_POINTS=4
EXTREME_ATR_RATIO_THRESHOLD=3.0
COOLDOWN_AFTER_SPIKE_SECONDS=120

# Spike detection (symbol family–specific multipliers vs ATR)
SPIKE_BODY_ATR_MULTIPLIER_BOOM=2.8
SPIKE_BODY_ATR_MULTIPLIER_CRASH=2.8
SPIKE_TICK_VELOCITY_THRESHOLD_BOOM=0.0015
SPIKE_TICK_VELOCITY_THRESHOLD_CRASH=0.0015

# Future execution guards
DAILY_LOSS_LIMIT_PERCENT=5.0
MAX_OPEN_TRADES=3

# Dashboard
DASHBOARD_REFRESH_SECONDS=2

# Logging
LOG_LEVEL=INFO
